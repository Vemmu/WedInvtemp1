# Public URL of the deployed site — required for absolute Open Graph image URLs (WhatsApp previews)
NEXT_SITE_URL=https://your-wedding-site.vercel.app

# Optional: RSVP submissions are POSTed (JSON) to this URL, e.g. a Google Apps Script web app
# that appends rows to a Google Sheet. If unset, RSVPs are only logged on the server.
RSVP_WEBHOOK_URL=
